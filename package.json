{
  "name": "@byteheng/dsh-vault",
  "version": "1.1.0",
  "type": "module",
  "description": "Encrypted vault for API tokens and credentials, with a sidebar panel for browsing and manual maintenance plus encrypted export/import between devices.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "bundle",
    "vault",
    "secrets",
    "credentials",
    "encryption"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whcater/dsh-vault.git"
  },
  "bugs": {
    "url": "https://github.com/whcater/dsh-vault/issues"
  },
  "homepage": "https://github.com/whcater/dsh-vault#readme",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
